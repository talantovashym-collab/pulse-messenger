# ==============================================================================
# ⚡ Pulse Messenger — Complete Production & Testing Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your real server domain, secrets, and telephony credentials.
# 3. For Docker deployment, docker-compose automatically loads this .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK TOPOLOGY
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Your server's public domain (or public IP address if testing without a domain)
# Examples: https://chat.example.com or http://165.227.12.34
DOMAIN_NAME=localhost
PUBLIC_URL=http://localhost:3000

# CORS whitelist (Use * for open testing, or comma-separated domains for strict production)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. SECURITY, CRYPTOGRAPHIC KEYS & SESSION SECRETS
# ------------------------------------------------------------------------------
# Generate strong 64-character random strings using:
# Linux/macOS/Git Bash: openssl rand -hex 32
# PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 48 | % {[char]$_})
SESSION_SECRET=pulse_session_super_secret_key_change_me_in_prod_998877
JWT_SECRET=pulse_jwt_signing_token_change_me_in_prod_445566
ENCRYPTION_MASTER_KEY=pulse_aes_master_secret_change_me_in_prod_112233

# ------------------------------------------------------------------------------
# 3. POSTGRESQL PRODUCTION DATA LAYER
# ------------------------------------------------------------------------------
# PostgreSQL 16 container credentials and connection URI
POSTGRES_USER=pulse_admin
POSTGRES_PASSWORD=pulse_secure_password_2026
POSTGRES_DB=pulse_chat
DATABASE_URL=postgresql://pulse_admin:pulse_secure_password_2026@pulse-postgres:5432/pulse_chat

# ------------------------------------------------------------------------------
# 4. REDIS & HORIZONTAL CLUSTER BUS
# ------------------------------------------------------------------------------
# Inter-node message bus syncing messages in <3ms across multiple server instances
REDIS_HOST=pulse-redis
REDIS_PORT=6379
REDIS_PASSWORD=pulse_redis_secret_change_me_2026
CLUSTER_PORT=6380
CLUSTER_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 5. REAL CELLULAR SMS VERIFICATION (Twilio & Carrier APIs)
# ------------------------------------------------------------------------------
# Sign up at https://www.twilio.com (free trial provides test number & balance)
# Leave empty to use Pulse's built-in Quick-Fill Dev Mode simulator.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# SMS Rate Limiting (Prevents toll fraud / spam attacks)
SMS_RATE_LIMIT_PER_10MIN=4
OTP_EXPIRY_MINUTES=5

# ------------------------------------------------------------------------------
# 6. WEBRTC AUDIO & VIDEO TRAVERSAL (STUN & TURN SERVERS)
# ------------------------------------------------------------------------------
# STUN servers discover public IPs across NATs (free public Google/Cloudflare STUN)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478

# TURN relay server is REQUIRED when peers are on mobile 4G/5G cellular data
# or strict corporate firewalls (e.g. Free Coturn server or Twilio Network Traversal)
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# 7. TELEGRAM-STYLE BOT API & CHANNELS
# ------------------------------------------------------------------------------
# Optional: Connect a real Telegram bot token from @BotFather for cross-platform bridging
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ------------------------------------------------------------------------------
# 8. MEDIA ATTACHMENTS & UPLOAD LIMITS
# ------------------------------------------------------------------------------
# Maximum file upload size in Megabytes (voice notes, pictures, videos, documents)
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# 9. AUTO-RECOVERY & CONTAINER RESILIENCE
# ------------------------------------------------------------------------------
# Docker restart policy: "unless-stopped" restarts containers automatically if the
# server reboots or if a process experiences an uncaught error.
RESTART_POLICY=unless-stopped
HEALTHCHECK_INTERVAL_SEC=15
