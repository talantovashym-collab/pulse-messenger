# =============================================
# Pulse Messenger — Environment Configuration
# =============================================
# Copy this file to .env and fill in your values.
# The .env file is loaded at server startup.
# NEVER commit your real .env to version control.

# --- Twilio SMS Gateway (Real Cellular SMS) ---
# Sign up free at https://www.twilio.com/try-twilio
# Free trial lets you send real SMS to verified numbers.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15005550006

# --- Server ---
PORT=3000

# --- PostgreSQL (optional, for production persistence) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/pulse_chat
