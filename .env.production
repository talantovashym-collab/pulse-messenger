# ==============================================================================
# ⚡ Pulse Messenger — Ready-to-Run Production Environment File
# ==============================================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

DOMAIN_NAME=localhost
PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=*

# Cryptographic Session & JWT Secrets
SESSION_SECRET=b6540c9d749962a9394625b59ea8976bcfd35b91e920d3b65287514a38df483a
JWT_SECRET=f9882a7f5a044bfb8d5a1b24e6c06a38096fa476a6ce4672e1c984da0e8e92c2
ENCRYPTION_MASTER_KEY=45c71b1e95cfb6e4f3a7a932b1327e5cb214dc7f3e587a8b4172559cf471e483

# PostgreSQL 16 Data Layer
POSTGRES_USER=pulse_admin
POSTGRES_PASSWORD=pulse_secure_password_2026
POSTGRES_DB=pulse_chat
DATABASE_URL=postgresql://pulse_admin:pulse_secure_password_2026@pulse-postgres:5432/pulse_chat

# Redis 7 Pub/Sub Cluster Bus
REDIS_HOST=pulse-redis
REDIS_PORT=6379
REDIS_PASSWORD=pulse_redis_secret_2026
CLUSTER_PORT=6380
CLUSTER_HOST=0.0.0.0

# Telephony (Leave empty to use built-in Quick-Fill dev mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_RATE_LIMIT_PER_10MIN=4
OTP_EXPIRY_MINUTES=5

# WebRTC STUN
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Bot API & Uploads
TELEGRAM_BOT_TOKEN=
MAX_UPLOAD_SIZE_MB=50

# Resilience
RESTART_POLICY=unless-stopped
HEALTHCHECK_INTERVAL_SEC=15
